# Copy to .env for local development (never commit .env).
# On Render: add the same VITE_* variables under Environment (required at build time).

# Firebase → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Must match auth.token.email in database.rules.json for movie uploads
VITE_UPLOADER_EMAIL=you@example.com

# true = UI + /api on same server (required for Render). Dev enables API automatically.
VITE_BUNDLE_API=true

# Only if the API runs on a different host than the UI (optional)
# VITE_API_BASE_URL=https://your-service.onrender.com

# Server (Render sets PORT automatically)
PORT=3000

# Optional: store videos on another drive if C: is full (Windows path example)
# UPLOADS_DIR=D:\our-cinema-uploads
